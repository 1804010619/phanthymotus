# ── GitHub ────────────────────────────────────────────────────────────────────
# Classic PAT with the `repo` scope. One token covers both repos.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token

# Repos to watch (comma-separated). Defaults to the two phanthymotus repos.
# GITHUB_REPOS=4paradigm/phanthymotus,4paradigm/phanthymotus-driver

# ── Trigger mode ──────────────────────────────────────────────────────────────
# Polling needs only outbound network: no public IP, no open port, no webhook
# registration. This is the default.
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=30
# On first start (no saved state), how far back to look for trigger comments.
POLL_INITIAL_LOOKBACK_MINUTES=10

# Webhook is optional and only useful if GitHub can reach this host inbound.
# Leaving it on is harmless — behind NAT it simply never receives anything.
WEBHOOK_ENABLED=true
# Required only when the webhook is actually reachable. Generate with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ── Mirrors ───────────────────────────────────────────────────────────────────
# Which mirror the repos' build scripts use when building core/perception/driver
# images. Passed through to build_core.sh / build_perception.sh / build.sh.
MIRROR=tencent

# Mirrors for building the agent's *own* image. Defaults are Tencent Cloud;
# uncomment and change these only if this host is outside the Tencent VPC.
# MIRROR_BASE=docker.io
# PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# BINFMT_IMAGE=docker.io/tonistiigi/binfmt

# ── Registry ──────────────────────────────────────────────────────────────────
REGISTRY=ccr.ccs.tencentyun.com
REGISTRY_USER=your_registry_user
REGISTRY_PASSWORD=your_registry_password
IMAGE_NAMESPACE=phanthy-motus
IMAGE_NAMESPACE_DRIVERS=phanthy-motus/drivers
PUSH_ENABLED=true

# ── LLM review (OpenAI-compatible /v1/chat/completions) ───────────────────────
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=claude-sonnet-4-20250514
MAX_DIFF_LINES=3000

# ── Worker ────────────────────────────────────────────────────────────────────
# Concurrent review jobs. Each gets its own git worktree, so they cannot
# interfere; raise this if the host has spare CPU and disk.
MAX_CONCURRENT_JOBS=2

# Timeout for a single `docker build` invocation.
BUILD_TIMEOUT_SECONDS=1800

# Whole-job timeout. A job exceeding this is presumed lost and retried.
# NOTE: builds run sequentially, so a PR touching N drivers needs roughly
# N * BUILD_TIMEOUT_SECONDS. Raise this if PRs routinely touch several drivers.
JOB_TIMEOUT_SECONDS=3600

# Total attempts per job including the first (3 = two retries). Only timeouts
# and infrastructure failures are retried; merge conflicts and genuine build
# failures are reported immediately.
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=60

# ── Paths / server ────────────────────────────────────────────────────────────
DATA_DIR=/data/repos
HOST=0.0.0.0
PORT=15690

# ── Resource Center (optional) ────────────────────────────────────────────────
# RESOURCE_CENTER_URL=https://motus.phanthy.com
# RESOURCE_CENTER_API_KEY=rc_your_key
