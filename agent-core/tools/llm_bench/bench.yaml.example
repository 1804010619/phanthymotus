# llm_bench 配置模板 —— 复制成 bench.yaml 再改
#
#   cp bench.yaml.example /opt/phanthy-motus/data/bench.yaml
#   chmod 600 /opt/phanthy-motus/data/bench.yaml
#
# 所有配置（含密钥）都在这一个文件里。bench.yaml 已被 .gitignore 挡住，
# 只有本模板进库。
#
# 机器人上 /opt/phanthy-motus/data/ 就是容器内的 /work/resource/，所以运行时
#   --config /work/resource/bench.yaml

corpus:
  dir: resource/llm_data      # agent-core 自己的请求日志，由 src/llm_logger.py 写出
  count: 50                   # 样本条数
  # even  = 跨越整个文件均匀取，覆盖各种 prompt 规模 —— 比延迟用这个
  # trace = 按整条 trace 取并保留轮次顺序，复现生产的前缀增长 —— 比缓存用这个
  #         （even 会打散 trace 内连续性：同 trace 相邻请求前缀重叠中位 93.3%，
  #          打散后只剩 40.0%，那样测出的缓存率不代表生产）
  # recent / random 也可用
  sampling: even
  seed: 42                    # 仅 random 用，保证可复现
  min_messages: 2             # 过滤退化样本

request:
  max_tokens: 10240           # 与生产 src/client/llm.py 一致
  timeout_s: 180
  extra_body:
    # 生产在 think_mode=false 时会带这个（src/client/llm.py:136-139）
    chat_template_kwargs:
      enable_thinking: false

run:
  # 跑两遍：冷轮（每条 payload 第一次被请求）+ 热轮（同一批再走一遍）。
  # 冷轮不是丢掉的预热 —— 冷态延迟和真实缓存率只能从它读，也进结论。
  # 设 0 则只跑热轮，那就没有冷态数据。
  warmup: 1
  order: rotate               # 逐条轮换组顺序，抵消时段漂移
  stop_after_consecutive_failures: 0   # 0 = 不早停；设 N 则某组连续失败 N 次后跳过该组

# 每组一个 (url, key, model)。一个入口配多个 models 会自动展开成多组，
# 组名 {name}/{model}，不必重复写 url 和 key。
groups:
  - name: router
    url: https://router.phanthy.com/v1
    key: sk-换成真的密钥
    models: [glm-5.3, zai-org/glm-5.3]

  - name: ppio
    url: https://api.ppio.com/openai
    key: sk_-换成真的密钥
    models: [zai-org/glm-5.3]

# 把 ConfigDB 里当前生产配置也加为一组 baseline（组名 current/{model}），
# 用来回答「换过去会不会比现在差」。它的密钥从 ConfigDB 读，不用写在这里。
# 命令行 --include-current / --no-include-current 可覆盖这一项。
# 用它时记得给容器带 -e DB_PATH=/work/resource/data.db
include_current: true
